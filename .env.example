# Public, non-secret local demo placeholders. Never copy production values into this file.
# Change every password and secret before any shared deployment.
POSTGRES_PASSWORD=airflow
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# Exact extract_attribute provider and the real local SBERT runtime.
EXTRACTION_BACKEND=codex_cli
EXTRACTION_MODEL=gpt-5.6-luna
EXTRACTION_REASONING_EFFORT=high
REVIEW_CATALOG_EXTRAS=[embedding,reclustering]
REVIEW_CATALOG_VERSION=0.4.0
CODEX_CLI_VERSION=0.146.0

# Public web port. API and Airflow remain bound to loopback by default.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
API_BIND_ADDRESS=127.0.0.1
AIRFLOW_BIND_ADDRESS=127.0.0.1

# Used only when EXTRACTION_BACKEND=openai.
OPENAI_API_KEY=
